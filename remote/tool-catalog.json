  {
    "name": "fitness_programs",
    "title": "Find programs",
    "description": "List one authorized page. Follow nextAfter even when the page is empty. Read only items relevant to the user request.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scopes": ["programs:read"],
    "route": "programs"
  },
  {
    "name": "fitness_resources",
    "title": "Read records",
    "description": "Read a bounded page or exact record before modifying it. Preserve epoch/revision. Never crawl all collections. Use personal scope only for the connected owner; revoked access is unavailable. Prefer the permission-specific read tools for new calls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "collection": {
          "type": "string",
          "enum": [
            "exerciseDocuments",
            "exercises",
            "goals",
            "health",
            "members",
            "planning",
            "programs",
            "runs",
            "schedules",
            "sessions",
            "workoutExercises",
            "workouts"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "archive": {
          "type": "string",
          "enum": ["active", "archived", "all"]
        }
      },
      "required": ["scope", "collection"],
      "additionalProperties": false
    },
    "scopes": [],
    "route": "resources"
  },
  {
    "name": "fitness_catalog",
    "title": "Find exercises",
    "description": "Search exercise catalogue; prefer stable catalog keys to creating duplicates. Continue with nextAfter and version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
